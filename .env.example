# Server-side keys, read only by netlify/functions/ai.mts.
# Do not add a VITE_ prefix: Vite copies VITE_ variables into the public JavaScript.
# On Netlify, set these under Site configuration > Environment variables and
# tick "Contains secret values" so a build fails if a key ever leaks into the output.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Cloudflare Workers AI: image generation (FLUX.1 schnell, about 170 images a day on the
# free plan) and the MeloTTS read-aloud voice. Free requests fail instead of billing.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional: change a backup model without touching code (for example when a
# provider retires one). Defaults: openai/gpt-oss-120b and openrouter/free.
GROQ_MODEL=
OPENROUTER_MODEL=

# Optional: read-aloud voice for Groq Orpheus (default hannah; also autumn, diana,
# austin, daniel, troy).
ORPHEUS_VOICE=
