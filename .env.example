# API keys for the serverless functions in netlify/functions.
# On Netlify, add them as environment variables marked secret.
# Do not prefix them with VITE_: Vite puts VITE_ variables in the public JavaScript.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Cloudflare Workers AI: image generation and one of the read-aloud voices.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional
GROQ_MODEL=
OPENROUTER_MODEL=
ORPHEUS_VOICE=
